# ─────────────────────────────────────────────────────────────────────────────
# SigNoz Production Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── SigNoz Image ─────────────────────────────────────────────────────────────
# Which Docker image tag to run. Update this when deploying a new release.
# e.g. ghcr.io/unifers/signoz:vPB-1.0.0
SIGNOZ_IMAGE=ghcr.io/unifers/signoz:vPB-1.0.0

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Change this to a strong random secret before running in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=1_AM*WEAK-PA55_Y0U-CAN_HACK-EAS1LY

# ── Ports ─────────────────────────────────────────────────────────────────────
# Ports the OTel Collector listens on (your apps send traces/metrics/logs here)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info
